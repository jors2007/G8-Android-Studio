<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fondo verde de la carta -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#009688"/> <!-- Verde -->
            <corners android:radius="12dp"/> <!-- Esquinas redondeadas -->
        </shape>
    </item>

    <!-- Borde blanco para separación -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="4dp"
                android:color="#FFFFFF"/> <!-- Borde blanco -->
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- Signo de interrogación en el centro -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

</layer-list>

