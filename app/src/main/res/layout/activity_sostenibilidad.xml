<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pantalla"
    android:padding="16dp"
    android:fillViewport="true">

    <!-- CONTENEDOR PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resumen Semanal"
            android:textAlignment="center"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/texto_titulo"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvRangoFechas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(Fecha)"
            android:textAlignment="center"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/bg_tarjeta"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Frecuencia de Acciones"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal"
                    android:layout_marginBottom="12dp"/>

                <include layout="@layout/item_accion_sostenible" android:id="@+id/row_transporte"/>
                <include layout="@layout/item_accion_sostenible" android:id="@+id/row_impresiones"/>
                <include layout="@layout/item_accion_sostenible" android:id="@+id/row_envases"/>
                <include layout="@layout/item_accion_sostenible" android:id="@+id/row_reciclaje"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/bg_tarjeta"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Análisis Ecológico"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_principal"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvAnalisis1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@color/texto_secundario"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvAnalisis2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@color/texto_secundario"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnRegistrarDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar Acciones del Día"
            android:backgroundTint="@color/acento_verde"
            android:textColor="#FFFFFF"
            android:paddingVertical="12dp"/>

    </LinearLayout>
</ScrollView>