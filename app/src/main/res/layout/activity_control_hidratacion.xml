<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Control de Hidratación"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?android:attr/colorPrimary"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="?android:attr/colorBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp"
            app:strokeColor="#33AAAAAA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha Actual"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="10dp"/>

                <ProgressBar
                    android:id="@+id/progressBarAgua"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="?android:attr/colorPrimary"/>

                <TextView
                    android:id="@+id/txtPorcentaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/colorPrimary"
                    android:layout_marginTop="15dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/txtMetaDiaria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meta diaria: 2500 ml"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorSecondary"/>

                    <Button
                        android:id="@+id/btnEstablecerMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EDITAR"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:strokeWidth="1dp" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registros del Día"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:id="@+id/layoutListaRegistros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?android:attr/colorBackground"
            android:padding="5dp">
        </LinearLayout>

        <TextView
            android:id="@+id/txtTotalConsumido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="20dp"
            android:text="Total Hoy: 0 ml"
            android:textAlignment="viewEnd"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <Button
            android:id="@+id/btnRegistrarAgua"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Registrar nueva toma"
            android:textSize="16sp"
            app:cornerRadius="30dp"
            android:backgroundTint="?android:attr/colorPrimary"
            android:textColor="?android:attr/textColorPrimaryInverse" />

    </LinearLayout>
</ScrollView>