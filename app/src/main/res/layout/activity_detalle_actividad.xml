<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <!-- Contenedor que permite centrar/acomodar en pantalla -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Contenido real (wrap_content para que el ScrollView siga funcionando) -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <!-- TITULO (en card para que no se vea pegado y se vea pro) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp">

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DETALLES DE LA ACTIVIDAD (ID 2)"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="14dp"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- INFORMACIÓN GENERAL -->
            <com.google.android.material.card.MaterialCardView
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:padding="14dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Información General"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- (Mantengo tus IDs intactos) -->
                    <TextView
                        android:id="@+id/tvNombre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre:"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvTipo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tipo:"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvAsignaturaLugar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asignatura/Lugar:"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvPrioridad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prioridad:"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estado:"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvFecha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha límite:"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvTiempoEstimado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiempo estimado total:"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvAvance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avance actual:"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- HISTORIAL -->
            <com.google.android.material.card.MaterialCardView
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:padding="14dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Historial de Gestión del Tiempo"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- CABECERA TABLA (fondo suave + padding) -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp"
                        android:background="#11000000">

                        <TextView
                            android:text="Fecha"
                            android:textStyle="bold"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Técnica"
                            android:textStyle="bold"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Duración (min)"
                            android:textStyle="bold"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- CONTENEDOR HISTORIAL -->
                    <LinearLayout
                        android:id="@+id/layoutHistorial"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BOTÓN VOLVER -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolver"
                android:text="Volver al listado"
                android:layout_marginTop="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                app:cornerRadius="14dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>