<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#191A1C"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MemoryGameActivity">

    <!-- Título -->
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="Juego de Memoria Sostenible"
        android:textColor="#009688"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Descripción -->
    <TextView
        android:id="@+id/txtDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="Pon a prueba tu memoria y aprende sobre sostenibilidad encontrando los pares correctos"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- Estadísticas -->
    <TextView
        android:id="@+id/txtIntentos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#B2DFDB"
        android:backgroundTint="#C8E6C9"
        android:gravity="center"
        android:padding="12dp"
        android:text="Intentos: 0 | Pares: 0/8"
        android:textColor="#009688"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Grid de cartas -->
    <GridLayout
        android:id="@+id/gridCartas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="4"
        android:padding="4dp"
        android:rowCount="4" />

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnReiniciar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#009688"
            android:padding="12dp"
            android:text="Reiniciar"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnMenuPrincipal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#009688"
            android:padding="12dp"
            android:text="Menú Principal"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>
