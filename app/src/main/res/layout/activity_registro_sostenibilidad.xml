<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#E8F5E9"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registro Diario de Sostenibilidad"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        android:textAlignment="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvFechaActual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(DD/MM/YYYY)"
        android:textSize="16sp"
        android:textColor="#388E3C"
        android:layout_marginBottom="24dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <CheckBox
                android:id="@+id/chkTransporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Usé transporte público, bicicleta o caminé."
                android:textSize="16sp"
                android:paddingStart="8dp"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/chkImpresiones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. No realicé impresiones."
                android:textSize="16sp"
                android:paddingStart="8dp"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/chkEnvases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. No utilicé envases descartables (usé mi termo/taza)."
                android:textSize="16sp"
                android:paddingStart="8dp"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/chkReciclaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Separé y reciclé materiales (vidrio, plástico, papel)."
                android:textSize="16sp"
                android:paddingStart="8dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <Button
            android:id="@+id/btnGuardarRegistro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Guardar"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnCancelarRegistro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</LinearLayout>